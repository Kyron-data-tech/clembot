# =============================================================================
# Clembot .gitignore — Windows & macOS
# =============================================================================

# ─── Secrets & API Keys (NEVER commit these) ─────────────────────────────────
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
secrets.json
credentials.json
service_account*.json

# ─── Runtime & State Files ────────────────────────────────────────────────────
*.log
clembot.log
.deps_installed

# App index cache (rebuilt automatically on startup)
app_index.json
**/app_index.json

# Code backup files created by the patch engine
*.bak

# Temp files
*.tmp
*.temp
*.swp
*~

# ─── Python Bytecode & Caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pytype/
*.pyo

# ─── Virtual Environments ─────────────────────────────────────────────────────
# venv is intentionally excluded — users create their own from requirements/
venv/
.venv/
env/
ENV/
Env/
.env/

# ─── Build & Distribution ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
eggs/
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST

# PyInstaller
*.spec
!packaging/**/*.spec
*.exe
*.dmg
*.app/

# ─── VS Code Extension Build Artifacts ────────────────────────────────────────
vscode-extension/node_modules/
**/node_modules/
vscode-extension/out/
**/out/
*.vsix
.vscode-test/

# ─── IDE & Editor Files ───────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ─── Windows OS Junk ──────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── macOS OS Junk ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# ─── Test & Coverage Artifacts ────────────────────────────────────────────────
.coverage
coverage.xml
*.cover
*.lcov
nosetests.xml
test-results/

# ─── Scratch / Temporary Work ─────────────────────────────────────────────────
scratch/
*.scratch.*
temp_test_*/

# ─── Whisper Model Cache (large binary files, downloaded on demand) ───────────
# Models are auto-downloaded to %APPDATA%/faster_whisper or ~/.cache — not in repo
faster_whisper_models/
whisper_models/
*.bin
*.gguf

# ─── Screenshot & Media Captures ──────────────────────────────────────────────
screenshots/
**/screenshots/
Clembot_Screenshot_*.png
Screenshot_*.png
*.wav
*.pcm

# ─── Node & Build Logs ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ─── Merge & System Artifacts ─────────────────────────────────────────────────
*.orig
*.rej
*.dmp
